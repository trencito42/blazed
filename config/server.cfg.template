# ═══════════════════════════════════════════════════════════════
#  SUNSETMP — FiveM RPG
# ═══════════════════════════════════════════════════════════════

endpoint_add_tcp "0.0.0.0:30120"
endpoint_add_udp "0.0.0.0:30120"

sv_hostname "blaze.mp | RPG Roleplay"
sets sv_projectName "blaze.mp"
sets sv_projectDesc "Blaze RPG — build your story."
sets tags "rpg, sunsetmp, english"
sets locale "en-US"

sv_maxclients 48
sv_enforceGameBuild 3751 # mp2025_02 — A Safehouse in the Hills

sv_licenseKey "__LICENSE_KEY__"
set mysql_connection_string "__MYSQL_CONNECTION_STRING__"

# ═══ SYSTEM ═══
ensure mapmanager
ensure sessionmanager
ensure hardcap

# ═══ OX + VOICE ═══
ensure ox_lib
ensure pma-voice
setr voice_useNativeAudio true
setr voice_useSendingRangeOnly false
setr voice_enableUi 0
setr voice_enableRadios 1
setr voice_enablePhones 1
setr voice_defaultCycle Z
# OneSync - required: server-side entity authority for damage gating and lookups
set onesync on
set onesync_population false
# [STATEBAG FIX] pma-voice (and other client libs) write LocalPlayer.state from
# the client; strict mode blocks them and spams warnings + breaks voice HUD.
setr sv_stateBagStrictMode false
# [A/B NOFX] 0 = normal mode (animations, filters, backgrounds enabled).
# Was 1 for the login-freeze A/B isolation test — test complete, fix applied.
# NOTE: setr (replicated) — the CLIENT reads it via GetConvar.
setr sv_sunset_nofx 0

# [JOBS DEBUG] 1 = enable verbose logging for job vehicle registration
# (registerVehicle rejections, model mismatches, session state).
set sv_sunset_jobs_debug 1

# ═══ DEV-ONLY TEST AGENT (MCP runtime bridge) ═══
# Injected from .env at deploy time (TEST_AGENT_ENABLED / TEST_AGENT_TOKEN).
# Defaults: disabled + empty token = bridge fully locked (fail-safe).
# Do NOT enable on production without understanding docs/testing/FIVEM_MCP.md.
ensure sunset_test_agent
setr sunset_test_agent_enabled "__TEST_AGENT_ENABLED__"
set sunset_test_agent_token "__TEST_AGENT_TOKEN__"
# Full NUI instrumentation (message/callback/error ring buffers for inspection)
setr sv_sunset_nuidebug "__TEST_AGENT_NUIDEBUG__"

# ox_inventory optional — enable after bridge migration
# ensure ox_inventory

