# ═══════════════════════════════════════════════════════════════
#  SUNSETMP — FiveM RPG
# ═══════════════════════════════════════════════════════════════

endpoint_add_tcp "0.0.0.0:30120"
endpoint_add_udp "0.0.0.0:30120"

sv_hostname "blaze.mp | RPG Roleplay"
sets sv_projectName "blaze.mp"
sets sv_projectDesc "Blaze RPG — build your story."
sets tags "rpg, sunsetmp, english"
sets locale "en-US"

sv_maxclients 48
sv_enforceGameBuild 3751 # mp2025_02 — A Safehouse in the Hills

sv_licenseKey "__LICENSE_KEY__"
set mysql_connection_string "__MYSQL_CONNECTION_STRING__"

# ═══ SYSTEM ═══
ensure mapmanager
ensure sessionmanager
ensure hardcap

# ═══ OX + VOICE ═══
ensure ox_lib
ensure pma-voice
setr voice_useNativeAudio true
setr voice_useSendingRangeOnly false
setr voice_enableUi 0
setr voice_enableRadios 1
setr voice_enablePhones 1
setr voice_defaultCycle Z
# OneSync - required: server-side entity authority for damage gating and lookups
set onesync on
set onesync_population false
setr sv_stateBagStrictMode true

# ox_inventory optional — enable after bridge migration
# ensure ox_inventory

# ═══ SUNSET CORE ═══
setr sv_showBusySpinnerOnLoadingScreen false
ensure sunset_loadscreen
ensure oxmysql
ensure bob74_ipl
ensure sunset_core
ensure sunset_sessions
ensure sunset_ui  
ensure sunset_chat
ensure sunset_world
ensure sunset_factions
ensure sunset_clans
ensure sunset_turfs
ensure sunset_dispatch
ensure sunset_crafting
ensure sunset_auth
ensure sunset_characters
ensure sunset_appearance
ensure sunset_spawn
ensure sunset_player
ensure sunset_inventory
ensure sunset_economy
ensure sunset_needs
ensure sunset_death
ensure sunset_vehicles
ensure sunset_tuning
ensure sunset_admin
ensure sunset_properties
ensure sunset_businesses
ensure sunset_emotes
ensure sunset_clothing
ensure sunset_phone
ensure sunset_interactions
ensure sunset_taxi
ensure sunset_fire
ensure sunset_documents
ensure sunset_licenses
ensure sunset_robbery
ensure sunset_pass
ensure sunset_hud
ensure sunset_dealership
ensure sunset_scoreboard
ensure sunset_menu
ensure sunset_help
ensure sunset_quests
ensure sunset_testdriver
ensure sunset_admintools
setr testdriver_autorun 1
ensure sunset_jobs
ensure sunset_carjack
ensure sunset_fishingshop

add_ace group.admin command allow
add_ace group.admin command.quit deny
